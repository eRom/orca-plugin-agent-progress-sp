{
  "manifestVersion": 2,
  "id": "agent-progress-sp",
  "name": "Agent Progress for Superpowers",
  "version": "0.1.0",
  "description": "Requires Superpowers. Shows where each Superpowers plan stands, read from its spec, plan and ledger: the current workspace's tasks and agent, the other work in progress, and the stage in the status bar.",
  "author": { "name": "Romain Ecarnot", "url": "https://github.com/eRom" },
  "repository": "https://github.com/eRom/orca-plugin-agent-progress-sp",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "events": [{ "on": "workspace.changed" }, { "on": "agent.status.changed" }],
    "statusBarItems": [{ "id": "progress", "icon": "layers", "command": "progress.toggle" }],
    "commands": [{ "id": "progress.toggle", "title": "Agent Progress: Toggle the sidebar" }]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "agent:read" },
    { "kind": "workspace:write" },
    { "kind": "storage:own" }
  ]
}
